[Unit]
Description=Zarfolio PocketBase Backend
After=network.target

[Service]
Type=simple
User=zf
Group=zf
WorkingDirectory=/home/zf/website/zar-main/backend
ExecStartPre=/bin/chmod +x /home/zf/website/zar-main/backend/pocketbase
ExecStart=/home/zf/website/zar-main/backend/pocketbase serve --http=127.0.0.1:8090
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/curl -sf http://127.0.0.1:8090/api/health >/dev/null && exit 0; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zarfolio-backend

[Install]
WantedBy=multi-user.target
